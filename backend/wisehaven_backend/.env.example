# Database
DATABASE_URL="postgresql://user:password@localhost:5432/wisehaven"

# Clerk Authentication
CLERK_SECRET_KEY="your-clerk-secret-key"

# MoMo Mobile Money API
MOMO_API_URL="https://sandbox.momodeveloper.mtn.com"
MOMO_ENVIRONMENT="sandbox"
MOMO_SUBSCRIPTION_KEY="your-momo-subscription-key"
MOMO_API_USER="your-momo-api-user-uuid"
MOMO_API_KEY="your-momo-api-key"
MOMO_CALLBACK_URL="http://localhost:8000/wallet/payment-callback"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Application
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Security
BCRYPT_WORK_FACTOR=12
RATE_LIMIT_PER_MINUTE=100

# Business Rules
FIRST_SWEEP_DEFAULT_PERCENTAGE=5.0
FIRST_SWEEP_MIN_PERCENTAGE=5.0
FIRST_SWEEP_MAX_PERCENTAGE=10.0
EMERGENCY_VAULT_MAX_WITHDRAWAL_PERCENTAGE=50.0
EMERGENCY_VAULT_COOLING_OFF_HOURS=24
MATURITY_CHECK_INTERVAL_MINUTES=5
NOTIFICATION_RETRY_ATTEMPTS=3
